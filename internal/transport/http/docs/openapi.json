{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "1.1.0",
    "description": "CRUD API for tasks and schedules. Schedules describe recurrence rules; a background worker automatically creates tasks from active schedules."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    },
    {
      "name": "Schedules",
      "description": "Operations with recurring task schedules"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/schedules": {
      "get": {
        "tags": ["Schedules"],
        "summary": "List schedules",
        "responses": {
          "200": {
            "description": "Schedule list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Schedule" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Schedules"],
        "summary": "Create schedule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateScheduleRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created schedule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/schedules/{id}": {
      "get": {
        "tags": ["Schedules"],
        "summary": "Get schedule by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Schedules"],
        "summary": "Update schedule",
        "description": "Pass `is_active: false` to pause a schedule without deleting it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateScheduleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated schedule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Schedule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Schedules"],
        "summary": "Delete schedule",
        "description": "Existing tasks created from this schedule stay in the tracker; their `schedule_id` becomes null.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Prepare release"
          },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Prepare release" },
          "description": {
            "type": "string",
            "example": "Collect release notes and check migrations"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "schedule_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "ID of the schedule this task was generated from. Null for manually created tasks.",
            "example": 42
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-03-24T00:00:00Z"
          }
        }
      },
      "RecurrenceType": {
        "type": "string",
        "enum": ["daily", "monthly", "even", "odd", "custom_dates", "end_of_month"],
        "description": "Type of recurrence rule. Each type has its own shape of `recurrence_params`:\n\n- `daily` — `{\"interval\": N}` where N >= 1. Create a task every N-th day.\n- `monthly` — `{\"day\": D}` where 1 <= D <= 30. Create on a specific day of month.\n- `even` — no params. Create on even days of the month.\n- `odd` — no params. Create on odd days of the month.\n- `custom_dates` — `{\"dates\": [\"2026-04-15\", ...]}`. Create on the listed dates (YYYY-MM-DD).\n- `end_of_month` — no params. Create on the last day of each month (28/29/30/31 depending on the month)."
      },
      "CreateScheduleRequest": {
        "type": "object",
        "required": ["title", "recurrence_type"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Ежедневный обход пациентов"
          },
          "description": {
            "type": "string",
            "example": "Проверить палаты и занести данные"
          },
          "recurrence_type": { "$ref": "#/components/schemas/RecurrenceType" },
          "recurrence_params": {
            "type": "object",
            "description": "Shape depends on `recurrence_type`. See `RecurrenceType` description.",
            "example": { "interval": 1 }
          }
        }
      },
      "UpdateScheduleRequest": {
        "type": "object",
        "required": ["title", "recurrence_type"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Ежедневный обход пациентов"
          },
          "description": {
            "type": "string",
            "example": "Проверить палаты и занести данные"
          },
          "recurrence_type": { "$ref": "#/components/schemas/RecurrenceType" },
          "recurrence_params": {
            "type": "object",
            "description": "Shape depends on `recurrence_type`. See `RecurrenceType` description.",
            "example": { "interval": 2 }
          },
          "is_active": {
            "type": "boolean",
            "description": "Set to false to pause the schedule without deleting it.",
            "example": true
          }
        }
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Ежедневный обход пациентов" },
          "description": { "type": "string", "example": "Проверить палаты и занести данные" },
          "recurrence_type": { "$ref": "#/components/schemas/RecurrenceType" },
          "recurrence_params": {
            "type": "object",
            "description": "Shape depends on `recurrence_type`.",
            "example": { "interval": 1 }
          },
          "is_active": { "type": "boolean", "example": true },
          "last_created_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Date when the worker last created a task from this schedule. Null if never.",
            "example": "2026-04-14"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-14T06:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-14T06:00:00Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "schedule not found" }
        }
      }
    }
  }
}
