{
  "openapi": "3.0.3",
  "info": {
    "title": "Task Service API",
    "version": "2.0.0",
    "description": "CRUD API for tasks with recurrence support."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Operations with tasks"
    },
    {
      "name": "Recurrence",
      "description": "Task recurrence rules"
    }
  ],
  "paths": {
    "/api/v1/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "List tasks",
        "description": "Returns all non-template tasks. Optionally filter by scheduled date.",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Filter tasks by scheduled date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date", "example": "2026-04-15" }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Task" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create task",
        "description": "Creates a regular task or a recurring task template. If 'recurrence' is provided, the task becomes a template and instances are generated automatically by the scheduler.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Task" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete task",
        "description": "Deletes a task. If the task is a template, all its generated instances and recurrence rule are also deleted (cascade).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/tasks/{id}/recurrence": {
      "get": {
        "tags": ["Recurrence"],
        "summary": "Get recurrence rule",
        "description": "Returns the recurrence rule for a task template.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Recurrence rule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurrenceRule" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Recurrence"],
        "summary": "Update recurrence rule",
        "description": "Updates the recurrence rule for a task template. Future unstarted instances (status 'new') are deleted and will be regenerated by the scheduler.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecurrenceInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated recurrence rule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecurrenceRule" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Recurrence"],
        "summary": "Delete recurrence rule",
        "description": "Removes the recurrence rule from a task template. The template task remains but no new instances will be generated.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64", "minimum": 1 }
          }
        ],
        "responses": {
          "204": { "description": "Deleted" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "RecurrenceInput": {
        "type": "object",
        "required": ["type", "start_date"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific_dates", "even_odd"],
            "description": "Recurrence type",
            "example": "daily"
          },
          "interval_days": {
            "type": "integer",
            "minimum": 1,
            "description": "For 'daily': create task every N days (default 1)",
            "example": 2
          },
          "day_of_month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "For 'monthly': day of the month (1-30)",
            "example": 15
          },
          "specific_dates": {
            "type": "array",
            "items": { "type": "string", "format": "date" },
            "description": "For 'specific_dates': list of specific dates",
            "example": ["2026-04-15", "2026-05-01"]
          },
          "even_odd": {
            "type": "string",
            "enum": ["even", "odd"],
            "description": "For 'even_odd': create on even or odd days of month",
            "example": "even"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Start date for the recurrence rule",
            "example": "2026-04-01"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "End date (optional, null = indefinite)",
            "example": "2026-12-31"
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Ежедневный обход пациентов"
          },
          "description": {
            "type": "string",
            "example": "Обойти всех пациентов в палатах 1-5"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "recurrence": {
            "$ref": "#/components/schemas/RecurrenceInput"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Ежедневный обход пациентов"
          },
          "description": {
            "type": "string",
            "example": "Обойти всех пациентов в палатах 1-5"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "in_progress"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "title": { "type": "string", "example": "Ежедневный обход пациентов" },
          "description": {
            "type": "string",
            "example": "Обойти всех пациентов в палатах 1-5"
          },
          "status": {
            "type": "string",
            "enum": ["new", "in_progress", "done"],
            "example": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-01T00:00:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-01T00:00:00Z"
          },
          "parent_task_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the parent template task (for generated instances)",
            "example": 1
          },
          "scheduled_date": {
            "type": "string",
            "format": "date",
            "description": "Scheduled date for this task instance",
            "example": "2026-04-15"
          },
          "is_template": {
            "type": "boolean",
            "description": "Whether this task is a recurrence template",
            "example": false
          }
        }
      },
      "RecurrenceRule": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "task_id": { "type": "integer", "format": "int64", "example": 1 },
          "type": {
            "type": "string",
            "enum": ["daily", "monthly", "specific_dates", "even_odd"],
            "example": "daily"
          },
          "interval_days": { "type": "integer", "example": 2 },
          "day_of_month": { "type": "integer", "example": 15 },
          "specific_dates": {
            "type": "array",
            "items": { "type": "string", "format": "date" },
            "example": ["2026-04-15", "2026-05-01"]
          },
          "even_odd": { "type": "string", "enum": ["even", "odd"], "example": "even" },
          "start_date": { "type": "string", "format": "date", "example": "2026-04-01" },
          "end_date": { "type": "string", "format": "date", "example": "2026-12-31" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "task not found" }
        }
      }
    }
  }
}
